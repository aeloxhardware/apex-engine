// y <- a*x + y en float32, sans contraction en FMA (precise -> NoContraction) :
// identique au bit au calcul CPU (/fp:precise). Fumee du socle Vulkan.
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) buffer Y { float y[]; };
layout(push_constant) uniform P { float a; uint n; uint offset; } p;
void main() {
    uint i = gl_GlobalInvocationID.x + p.offset;
    if (i >= p.n) return;
    precise float t = p.a * x[i];
    precise float r = t + y[i];
    y[i] = r;
}
