// y <- a*x + y en float64 (shaderFloat64), sans contraction en FMA.
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { double x[]; };
layout(std430, binding = 1) buffer Y { double y[]; };
layout(push_constant) uniform P { double a; uint n; uint offset; } p;
void main() {
    uint i = gl_GlobalInvocationID.x + p.offset;
    if (i >= p.n) return;
    precise double t = p.a * x[i];
    precise double r = t + y[i];
    y[i] = r;
}
